# Application Settings
APP_NAME=Mesosfer Agentic Discovery
DEBUG=True

# Active LLM Provider: "custom", "ollama", or "amd"
LLM_PROVIDER=custom

# AMD Token Factory Configuration (OpenAI-compatible; key format "rc-" + 48 hex)
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_DEFAULT_MODEL=DeepSeek-V4-Flash
AMD_FAST_MODEL=DeepSeek-V4-Flash
AMD_REASONING_MODEL=DeepSeek-V4-Flash
AMD_TIMEOUT=600.0

# Global LLM limits (AMD shared team key: 30 RPM, 8 concurrent)
LLM_MAX_CONCURRENCY=6
LLM_RPM_LIMIT=30
LLM_MAX_RETRIES=4
# Products scored per trust LLM call
TRUST_BATCH_SIZE=8

# Discovery (Stage 1): leave DISCOVERY_SITES empty to pick marketplaces per request country
# (see app/services/regions.py; no country = global list). Set comma-separated domains to override for all requests.
DISCOVERY_SITES=
DISCOVERY_MAX_CANDIDATES=30
DISCOVERY_PAGE_TIMEOUT_MS=15000
DISCOVERY_RENDER_WAIT_MS=4000
DISCOVERY_CONCURRENCY=10
DISCOVERY_SEARCH_CONCURRENCY=3
# Max share of candidates taken from Google Shopping (the rest are web product pages)
DISCOVERY_SHOPPING_SHARE=0.6

# Search source: "marketplace" (direct store search, no API key) or "serpapi" (API)
SEARCH_PROVIDER=marketplace
SERPAPI_API_KEY=
# Leave empty to derive Google gl/hl from the request country (no country: gl=us, hl=en).
# If set, used only for requests without a country.
SERPAPI_GL=
SERPAPI_HL=
SERPAPI_TIMEOUT=20
# Resolve merchant store links for the top N shopping candidates (1 SerpAPI call each); 0 disables
SERPAPI_RESOLVE_TOP_N=10
# Hard cap on resolutions per request; extra ones run only if too few candidates have a store link.
# Candidates still on a google.com link are dropped before trust.
SERPAPI_RESOLVE_MAX=15

# Redis Queue & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Custom OpenAI-compatible Provider (bandelbanget.xyz)
CUSTOM_LLM_BASE_URL=https://bandelbanget.xyz/v1
CUSTOM_LLM_API_KEY=your_api_key_here
CUSTOM_LLM_DEFAULT_MODEL=deepseek-v4-flash
CUSTOM_LLM_FAST_MODEL=kimi-k2.5
CUSTOM_LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
CUSTOM_LLM_REASONING_MODEL=deepseek-v4-pro
CUSTOM_LLM_TIMEOUT=60.0

# Ollama Provider Configuration (Local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=60.0
