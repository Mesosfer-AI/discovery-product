# Shared configuration for Docker Compose and all three applications.
# Copy this file to .env at the repository root; keep credentials out of Git.
# APP_KEY may stay empty for automatic generation into persistent Laravel storage.
# For AMD + SerpAPI: select LLM_PROVIDER=amd and SEARCH_PROVIDER=serpapi, then fill both API keys.
# VITE_* values are public and included in the frontend bundle.
APP_PORT=47281
APP_URL=http://localhost:47281
APP_KEY=
DB_DATABASE=mesosfer
DB_USERNAME=mesosfer
DB_PASSWORD=
APP_NAME=Mesosfer
APP_ENV=production
APP_DEBUG=false
SERVER_PORT=8001
AI_SERVICE_URL=http://ai:47283
# Background worker's maximum wait for one AI search, in seconds.
AI_SERVICE_TIMEOUT=600
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
DB_CONNECTION=mysql
# Existing MySQL reachable from application containers.
DB_HOST=host.docker.internal
DB_PORT=3306
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
# Existing Redis; REDIS_URL is used by AI and must include its credentials when required.
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional existing S3/MinIO endpoint and public URL; requires an S3 adapter to use the s3 disk.
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
VITE_APP_NAME="${APP_NAME}"
DEBUG=false
LLM_PROVIDER=custom
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_DEFAULT_MODEL=DeepSeek-V4-Flash
AMD_FAST_MODEL=DeepSeek-V4-Flash
AMD_REASONING_MODEL=DeepSeek-V4-Flash
AMD_TIMEOUT=600.0
LLM_MAX_CONCURRENCY=6
LLM_RPM_LIMIT=30
LLM_MAX_RETRIES=4
TRUST_BATCH_SIZE=8
DISCOVERY_SITES=
DISCOVERY_MAX_CANDIDATES=30
DISCOVERY_PAGE_TIMEOUT_MS=15000
DISCOVERY_RENDER_WAIT_MS=4000
DISCOVERY_CONCURRENCY=10
DISCOVERY_SEARCH_CONCURRENCY=3
DISCOVERY_SHOPPING_SHARE=0.6
SEARCH_PROVIDER=marketplace
SERPAPI_API_KEY=
SERPAPI_GL=
SERPAPI_HL=
SERPAPI_TIMEOUT=20
SERPAPI_RESOLVE_TOP_N=10
SERPAPI_RESOLVE_MAX=15
REDIS_URL=redis://host.docker.internal:6379/0
CUSTOM_LLM_BASE_URL=https://bandelbanget.xyz/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_DEFAULT_MODEL=deepseek-v4-flash
CUSTOM_LLM_FAST_MODEL=kimi-k2.5
CUSTOM_LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
CUSTOM_LLM_REASONING_MODEL=deepseek-v4-pro
CUSTOM_LLM_TIMEOUT=60.0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=60.0
VITE_BACKEND_URL=
